@model SlojPodataka.PrijavaTakmicara

@{
    ViewBag.Title = "Detalji Prijave";
}

<h2>Detalji prijave</h2>

<div class="panel panel-default">
    <div class="panel-heading">
        <h4>Osnovni podaci o prvenstvu</h4>
    </div>
    <div class="panel-body">
        <dl class="dl-horizontal">
            <dt>ID Prijave:</dt>
            <dd>@Model.PrijavaID</dd>

            <dt>Naziv Prvenstva:</dt>
            <dd>@Model.NazivPrvenstva</dd>

            <dt>Disciplina:</dt>
            <dd>@Model.Disciplinam</dd>

            <dt>Mesto:</dt>
            <dd>@Model.Mesto</dd>
        </dl>
    </div>
</div>

<h3>Prijavljeni takmičari</h3>

@if ( Model.StavkaPrijave != null && Model.StavkaPrijave.Any() )
{
    <table class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Ime i Prezime</th>
                <th>Datum Rođenja</th>
                <th>Kategorija ID</th>
                <th>Težinska Kategorija</th>
            </tr>
        </thead>
        <tbody>
            @foreach ( var stavka in Model.StavkaPrijave )
            {
                <tr>
                    <td>@stavka.ImePrezime</td>
                    <td>@(stavka.DatumRodjenja != null ? stavka.DatumRodjenja.ToString("dd.MM.yyyy.") : "")</td>
                    <td>@stavka.KategorijaID</td>
                    <td>@stavka.TezinskaKategorija</td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-warning">Nema prijavljenih takmičara za ovu prijavu.</p>
}

<p>
    @Html.ActionLink("Izmeni", "Izmeni", new { id = Model.PrijavaID }, new { @class = "btn btn-warning" })
    @Html.ActionLink("Nazad na listu", "Prikaz", null, new { @class = "btn btn-default" })
</p>